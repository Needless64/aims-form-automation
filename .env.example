[TEMPLATE]
# ---------------------------------------------------------------------------
# AIMS Admissions — server-side configuration
# Copy this file to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Mailbox that sends both emails, and the app password generated for it.
# Gmail: enable 2-Step Verification, then create an App Password
# (Google Account → Security → App passwords). Your normal password will not work.
SMTP_USER=admissions@your-mailbox.example
SMTP_APP_PASSWORD="abcd efgh ijkl mnop"

# Optional for Gmail, Outlook, Yahoo and Zoho (the host is inferred from the
# address). Required for any other mail server, e.g. mail.your-domain.example.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_SECURE=true

# Sender shown to recipients. Must be the SMTP_USER mailbox (or an alias the
# mail server is allowed to send as). Defaults to "AIMS Admissions <SMTP_USER>".
EMAIL_FROM="AIMS Admissions <admissions@your-mailbox.example>"

# Admissions inbox that receives the internal notification.
ADMISSIONS_EMAIL=admissions@aims.ac.in

# Optional. Public HTTPS URL of the logo at the top of both emails: the
# institution lockup (crest, wordmark and hospital line). The recipient's mail
# client fetches it, so a file in /public only works once the site is deployed.
# Use a PNG or JPEG — Outlook does not render WebP.
#
# This lockup is opaque with the brand navy (#0d2346) baked in. Keep
# EMAIL_COLORS.navyDeep in lib/email/components.ts in step with it, or the image
# shows as a slightly different rectangle on the band.
EMAIL_LOGO_URL=https://i.ibb.co/60XQBJ5R/Screenshot-2026-10-27-213641.png

# Optional. Send mail by dispatching a GitHub Actions runner, which does have
# raw sockets. This is what the deployed site uses: the enquiry is sealed with
# MAIL_PAYLOAD_KEY and handed to .github/workflows/send-enquiry-mail.yml in the
# aims-form-automation repository, which sends both emails over SMTP.
# See "Mail sent by a GitHub Actions runner" in README.md.
# GITHUB_DISPATCH_REPO=owner/aims-form-automation
# GITHUB_DISPATCH_TOKEN=github_pat_...   # fine-grained, Actions: read and write
# GITHUB_DISPATCH_WORKFLOW=send-enquiry-mail.yml
# GITHUB_DISPATCH_REF=main
# MAIL_PAYLOAD_KEY=                      # openssl rand -base64 32 — same value in the repository's secrets
#
# Optional. Send mail over HTTPS instead of SMTP. SMTP needs raw sockets, which
# Cloudflare Workers do not provide, so a deployed Worker cannot use it.
#
# Brevo (formerly Sendinblue) verifies a sender email address instead of a
# domain, which is what makes it usable without a domain of your own: create an
# account, verify the address you will send from, then create an API key.
# EMAIL_FROM must be that verified address. Used only when no dispatch token is
# set, so leave GITHUB_DISPATCH_TOKEN unset to fall back to it.
# BREVO_API_KEY=
# EMAIL_FROM="AIMS Admissions <your-verified-address@gmail.com>"
#
# Alternative: your own relay. Point this at the same Apps Script deployment
# that records the spreadsheet (README → "Record enquiries in a Google Sheet");
# its doPost sends { mail: ... } as well as appending rows.
# EMAIL_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec
# EMAIL_WEBHOOK_SECRET=
#
# Optional. Force a transport: smtp | github | brevo | webhook. Inferred from
# the variables above when unset.
# EMAIL_TRANSPORT=

# Optional. Google Sheet ledger. SHEETS_WEBHOOK_URL is the /exec URL of the
# Apps Script web app bound to the sheet; SHEETS_WEBHOOK_SECRET is the same
# secret that script checks. Leave the URL unset to record nothing; enquiries
# still send their emails. See "Record enquiries in a Google Sheet" in README.md.
# SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbx.../exec
# SHEETS_WEBHOOK_SECRET=

# Optional. Bearer token for POST /api/admissions/retry. Leave unset to disable
# the retry endpoint entirely.
ADMIN_RETRY_TOKEN=

# Optional. Public site URL, used in metadata. No trailing slash.
SITE_URL=http://localhost:3000
